# Application Meta
APP_NAME="WatchSphere AI – Customer Insights Platform"
APP_VERSION="3.0.0"
APP_ENV="development"
DEBUG=True

# Backend Server Configuration
HOST="127.0.0.1"
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite by default; works with PostgreSQL/MySQL seamlessly)
DATABASE_URL="sqlite:///./watchsphere.db"

# Security & JWT Configuration
SECRET_KEY="watchsphere-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL="INFO"
LOG_DIR="logs"
SYSTEM_LOG_FILE="logs/system.log"
ERROR_LOG_FILE="logs/error.log"
